# Copy to .env. Every line is optional.

# Ollama. host (default): the machine's own Ollama. container: the fallback,
# the ollama service in docker-compose.yml with its own models.
OLLAMA_RUNTIME=host
# host, --docker: the address the app container uses for the machine's Ollama.
# OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
# container: the port it is published on, 127.0.0.1 only (11434 is the host's).
# OLLAMA_CONTAINER_PORT=11435

# The model is OLLAMA_MODEL in ai-models.env (generated, do not edit it).
# Set it here to use another model on this machine.
# OLLAMA_MODEL=
